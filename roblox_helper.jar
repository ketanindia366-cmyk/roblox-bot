# Save as build_jar.py and run once to create roblox_helper.jar
import os
import subprocess

java_code = """
import java.io.FileWriter;
import java.io.IOException;
import java.io.PrintWriter;
import java.time.LocalDateTime;
import java.time.format.DateTimeFormatter;

public class RobloxLogTracker {
    public static void main(String[] args) {
        if (args.length < 3) {
            System.out.println("❌ Missing args.");
            System.exit(1);
        }
        String userId = args[0];
        String actionType = args[1].toUpperCase();
        String rankId = args[2];

        String fileName = "java_audit_ledger.txt";
        try (FileWriter fw = new FileWriter(fileName, true);
             PrintWriter pw = new PrintWriter(fw)) {
            String logEntry = String.format("[%s] [JAVA] Action: %s | Target ID: %s | Rank ID: %s", 
                    LocalDateTime.now().format(DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm:ss")), actionType, userId, rankId);
            pw.println(logEntry);
            System.out.println("Logged: " + actionType);
        } catch (IOException e) {
            System.out.println("❌ Error: " + e.getMessage());
        }
    }
}
"""

with open("RobloxLogTracker.java", "w") as f:
    f.write(java_code)

try:
    subprocess.run(["javac", "RobloxLogTracker.java"], check=True)
    subprocess.run(["jar", "cfe", "roblox_helper.jar", "RobloxLogTracker", "RobloxLogTracker.class"], check=True)
    print("✅ roblox_helper.jar created successfully!")
    os.remove("RobloxLogTracker.java")
    os.remove("RobloxLogTracker.class")
except Exception:
    print("❌ Java JDK not found on your system. Creating a mock jar tracker instead.")
    with open("roblox_helper.jar", "w") as f:
        f.write("MOCK_JAR_BINARY_DATA")
